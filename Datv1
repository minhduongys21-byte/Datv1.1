local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- CẤU HÌNH BÀN CỜ
-- ==========================================
local BOARD_START = Vector3.new(-14, 5, -14)
local TILE_SIZE = 4
local FILES = {"a", "b", "c", "d", "e", "f", "g", "h"}

local isChessEnabled = false
local boardState = {}
local selectedSquare = nil
local validMovesHighlights = {}

local activePieces = workspace:FindFirstChild("ActiveChessPieces") or Instance.new("Folder")
activePieces.Name = "ActiveChessPieces"
activePieces.Parent = workspace

local tilesFolder = workspace:FindFirstChild("BoardTiles") or Instance.new("Folder")
tilesFolder.Name = "BoardTiles"
tilesFolder.Parent = workspace

-- ==========================================
-- HÀM DỌN DẸP / HIỂN THỊ HỢP LỆ
-- ==========================================
local function clearHighlights()
	for _, hl in ipairs(validMovesHighlights) do
		hl:Destroy()
	end
	validMovesHighlights = {}
end

local function clearBoard()
	activePieces:ClearAllChildren()
	tilesFolder:ClearAllChildren()
	boardState = {}
	clearHighlights()
	selectedSquare = nil
end

local function getFileAndRank(square)
	local fChar = string.sub(square, 1, 1)
	local rNum = tonumber(string.sub(square, 2, 2))
	local fNum = table.find(FILES, fChar)
	return fNum, rNum
end

local function getSquareFromCoords(f, r)
	if f >= 1 and f <= 8 and r >= 1 and r <= 8 then
		return FILES[f] .. tostring(r)
	end
	return nil
end

-- ==========================================
-- THUẬT TOÁN TÍNH NƯỚC ĐI HỢP LỆ
-- ==========================================
local function getValidMoves(square)
	local piece = boardState[square]
	if not piece then return {} end
	
	local moves = {}
	local f, r = getFileAndRank(square)
	local isWhite = (piece == string.upper(piece))
	local pType = string.upper(piece)
	
	local function addMove(tf, tr)
		local targetSq = getSquareFromCoords(tf, tr)
		if not targetSq then return false end
		local targetPiece = boardState[targetSq]
		if not targetPiece then
			table.insert(moves, targetSq)
			return true
		else
			local isTargetWhite = (targetPiece == string.upper(targetPiece))
			if isWhite ~= isTargetWhite then
				table.insert(moves, targetSq)
			end
			return false
		end
	end
	
	if pType == "P" then
		local dir = isWhite and 1 or -1
		local startRank = isWhite and 2 or 7
		local f1 = getSquareFromCoords(f, r + dir)
		if f1 and not boardState[f1] then
			table.insert(moves, f1)
			local f2 = getSquareFromCoords(f, r + 2 * dir)
			if r == startRank and f2 and not boardState[f2] then
				table.insert(moves, f2)
			end
		end
		for _, df in ipairs({-1, 1}) do
			local diagSq = getSquareFromCoords(f + df, r + dir)
			if diagSq and boardState[diagSq] then
				local isTargetWhite = (boardState[diagSq] == string.upper(boardState[diagSq]))
				if isWhite ~= isTargetWhite then
					table.insert(moves, diagSq)
				end
			end
		end
	elseif pType == "N" then
		local offsets = {{-2,-1},{-2,1},{-1,-2},{-1,2},{1,-2},{1,2},{2,-1},{2,1}}
		for _, off in ipairs(offsets) do addMove(f + off[1], r + off[2]) end
	elseif pType == "R" or pType == "B" or pType == "Q" then
		local dirs = {}
		if pType == "R" or pType == "Q" then
			table.insert(dirs, {1,0}); table.insert(dirs, {-1,0}); table.insert(dirs, {0,1}); table.insert(dirs, {0,-1})
		end
		if pType == "B" or pType == "Q" then
			table.insert(dirs, {1,1}); table.insert(dirs, {-1,1}); table.insert(dirs, {1,-1}); table.insert(dirs, {-1,-1})
		end
		for _, d in ipairs(dirs) do
			local step = 1
			while true do
				local canContinue = addMove(f + d[1]*step, r + d[2]*step)
				if not canContinue then break end
				step = step + 1
			end
		end
	elseif pType == "K" then
		for df = -1, 1 do
			for dr = -1, 1 do
				if not (df == 0 and dr == 0) then addMove(f + df, r + dr) end
			end
		end
	end
	return moves
end

-- ==========================================
-- TẠO BÀN CỜ 3D VÀ NẠP FEN
-- ==========================================
local function onSquareClicked(clickedSquare)
	if not isChessEnabled then return end
	local validMoves = selectedSquare and getValidMoves(selectedSquare) or {}
	
	if selectedSquare and table.find(validMoves, clickedSquare) then
		boardState[clickedSquare] = boardState[selectedSquare]
		boardState[selectedSquare] = nil
		clearHighlights()
		
		for _, p in ipairs(activePieces:GetChildren()) do
			if string.sub(p.Name, -2) == clickedSquare then p:Destroy() end
		end
		for _, p in ipairs(activePieces:GetChildren()) do
			if string.sub(p.Name, -2) == selectedSquare then
				local tile = tilesFolder:FindFirstChild(clickedSquare)
				p.Position = tile.Position + Vector3.new(0, 1.75, 0)
				p.Name = string.sub(p.Name, 1, #p.Name - 2) .. clickedSquare
			end
		end
		selectedSquare = nil
		return
	end
	
	clearHighlights()
	if boardState[clickedSquare] then
		selectedSquare = clickedSquare
		local moves = getValidMoves(clickedSquare)
		
		local selTile = tilesFolder:FindFirstChild(clickedSquare)
		if selTile then
			local hl = Instance.new("SelectionBox")
			hl.Color3 = Color3.fromRGB(255, 255, 0)
			hl.Adornee = selTile
			hl.Parent = selTile
			table.insert(validMovesHighlights, hl)
		end
		
		for _, moveSq in ipairs(moves) do
			local tile = tilesFolder:FindFirstChild(moveSq)
			if tile then
				local hl = Instance.new("SelectionBox")
				hl.Color3 = Color3.fromRGB(50, 255, 50)
				hl.LineThickness = 0.15
				hl.Adornee = tile
				hl.Parent = tile
				table.insert(validMovesHighlights, hl)
			end
		end
	else
		selectedSquare = nil
	end
end

local function enableChess(fenString)
	clearBoard()
	isChessEnabled = true
	fenString = (fenString and fenString ~= "") and fenString or "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
	
	-- Tạo 64 ô cờ
	for r = 1, 8 do
		for f = 1, 8 do
			local squareName = FILES[f] .. tostring(9 - r)
			local tile = Instance.new("Part")
			tile.Name = squareName
			tile.Size = Vector3.new(TILE_SIZE - 0.2, 0.5, TILE_SIZE - 0.2)
			tile.Position = BOARD_START + Vector3.new((f - 1) * TILE_SIZE, 0, (r - 1) * TILE_SIZE)
			tile.Anchored = true
			tile.Material = Enum.Material.SmoothPlastic
			tile.Color = ((r + f) % 2 == 0) and Color3.fromRGB(240, 217, 181) or Color3.fromRGB(181, 136, 99)
			
			local clickDetector = Instance.new("ClickDetector")
			clickDetector.MaxActivationDistance = 32
			clickDetector.Parent = tile
			clickDetector.MouseClick:Connect(function()
				onSquareClicked(squareName)
			end)
			
			tile.Parent = tilesFolder
		end
	end
	
	-- Nạp FEN
	local boardData = string.split(fenString, " ")[1]
	local ranks = string.split(boardData, "/")
	
	for rankIdx, rankData in ipairs(ranks) do
		local r = 9 - rankIdx
		local f = 1
		for i = 1, #rankData do
			local char = string.sub(rankData, i, i)
			local num = tonumber(char)
			
			if num then
				f = f + num
			else
				local sq = getSquareFromCoords(f, r)
				boardState[sq] = char
				
				local piecePart = Instance.new("Part")
				piecePart.Name = char .. "_" .. sq
				piecePart.Size = Vector3.new(2.5, 3, 2.5)
				
				local tile = tilesFolder:FindFirstChild(sq)
				if tile then piecePart.Position = tile.Position + Vector3.new(0, 1.75, 0) end
				
				piecePart.Anchored = true
				piecePart.Color = (char == string.upper(char)) and Color3.fromRGB(245, 245, 245) or Color3.fromRGB(35, 35, 35)
				
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.new(1.5, 0, 1.5, 0)
				bb.AlwaysOnTop = true
				bb.Adornee = piecePart
				bb.Parent = piecePart
				
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1,0,1,0)
				lbl.BackgroundTransparency = 1
				lbl.Text = char
				lbl.TextScaled = true
				lbl.TextColor3 = (char == string.upper(char)) and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
				lbl.Font = Enum.Font.SourceSansBold
				lbl.Parent = bb
				
				piecePart.Parent = activePieces
				f = f + 1
			end
		end
	end
end

local function disableChess()
	isChessEnabled = false
	clearBoard()
end

-- ==========================================
-- GIAO DIỆN MENU ON/OFF CÓ THỂ KÉO THẢ
-- ==========================================
local function createChessMenu(player)
	local playerGui = player:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("ChessControlGui") then playerGui.ChessControlGui:Destroy() end
	
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ChessControlGui"
	screenGui.ResetOnSpawn = false
	
	local main = Instance.new("Frame")
	main.Size = UDim2.new(0, 320, 0, 210)
	main.Position = UDim2.new(0.5, -160, 0.4, 0)
	main.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	main.BorderSizePixel = 0
	main.Parent = screenGui
	
	local outline = Instance.new("UIStroke")
	outline.Color = Color3.fromRGB(255, 30, 50)
	outline.Thickness = 2
	outline.Parent = main
	
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 35)
	title.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	title.Text = "♟️ MENU CỜ VUA (DAT V1)"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.Font = Enum.Font.SourceSansBold
	title.TextSize = 16
	title.Parent = main
	
	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, 0, 0, 25)
	status.Position = UDim2.new(0, 0, 0.2, 0)
	status.BackgroundTransparency = 1
	status.Text = "STATUS: OFF"
	status.TextColor3 = Color3.fromRGB(180, 180, 190)
	status.Font = Enum.Font.SourceSans
	status.TextSize = 14
	status.Parent = main
	
	local inputFEN = Instance.new("TextBox")
	inputFEN.Size = UDim2.new(0.88, 0, 0, 35)
	inputFEN.Position = UDim2.new(0.06, 0, 0.36, 0)
	inputFEN.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	inputFEN.TextColor3 = Color3.fromRGB(255, 255, 255)
	inputFEN.PlaceholderText = "Nhập FEN (Bỏ trống = Ván mới)..."
	inputFEN.Text = ""
	inputFEN.Font = Enum.Font.SourceSans
	inputFEN.TextSize = 13
	inputFEN.ClearTextOnFocus = false
	inputFEN.Parent = main
	
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0.88, 0, 0, 40)
	button.Position = UDim2.new(0.06, 0, 0.62, 0)
	button.BackgroundColor3 = Color3.fromRGB(45, 20, 25)
	button.Text = "CHESS : OFF"
	button.TextColor3 = Color3.fromRGB(255, 50, 65)
	button.Font = Enum.Font.SourceSansBold
	button.TextSize = 18
	button.Parent = main
	
	screenGui.Parent = playerGui
	
	-- Xử lý ON / OFF
	button.Activated:Connect(function()
		if isChessEnabled then
			disableChess()
			button.Text = "CHESS : OFF"
			button.TextColor3 = Color3.fromRGB(255, 50, 65)
			button.BackgroundColor3 = Color3.fromRGB(45, 20, 25)
			outline.Color = Color3.fromRGB(255, 30, 50)
			status.Text = "STATUS: RESTORED"
			status.TextColor3 = Color3.fromRGB(180, 180, 190)
		else
			enableChess(inputFEN.Text)
			button.Text = "CHESS : ON"
			button.TextColor3 = Color3.fromRGB(50, 255, 100)
			button.BackgroundColor3 = Color3.fromRGB(20, 45, 25)
			outline.Color = Color3.fromRGB(50, 255, 100)
			status.Text = "STATUS: ACTIVE"
			status.TextColor3 = Color3.fromRGB(100, 255, 150)
		end
	end)
	
	-- Kéo Menu trên PC / Mobile
	local UserInputService = game:GetService("UserInputService")
	local dragging = false
	local dragStart, startPosition
	
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = main.Position
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPosition.X.Scale, startPosition.X.Offset + delta.X,
				startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
			)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- Chạy ngay lập tức khi LocalScript được tải
createChessMenu(LocalPlayer)
